<Window x:Class="UnicAccountingSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نصب سیستم حسابداری یونیک" Height="440" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="#F0F4FF">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <Style TargetType="Button" x:Key="Primary">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🧮" FontSize="34" Margin="12,0,0,0"/>
            <StackPanel>
                <TextBlock Text="سیستم حسابداری یونیک" FontSize="18" FontWeight="Bold" Foreground="#0D1B2A"/>
                <TextBlock Text="نصب برنامه آفلاین دسکتاپ" FontSize="12" Foreground="#607D8B"/>
            </StackPanel>
        </StackPanel>

        <!-- Page 1: install form -->
        <StackPanel x:Name="FormPanel" Grid.Row="2" VerticalAlignment="Top">
            <TextBlock Text="پوشه نصب" FontWeight="SemiBold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtInstallDir" Grid.Column="0" Text="C:\UnicAccounting"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="انتخاب..." Click="BtnBrowse_Click"
                        Margin="0,4,8,14" Padding="10,6"/>
            </Grid>

            <TextBlock Text="برنامه پس از نصب، پایگاه داده خودش را به صورت خودکار در اولین اجرا می‌سازد — نیازی به تنظیم دستی نیست."
                       TextWrapping="Wrap" Foreground="#607D8B" FontSize="12" Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtError" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Page 2: progress -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="2" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="TxtProgressStatus" Text="در حال نصب..." FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <ProgressBar x:Name="ProgressBar" Height="10" Minimum="0" Maximum="100" FlowDirection="LeftToRight"/>
        </StackPanel>

        <!-- Page 3: done -->
        <StackPanel x:Name="DonePanel" Grid.Row="2" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="✓ نصب با موفقیت انجام شد" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="یک میانبر روی دسکتاپ شما اضافه شد." HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <CheckBox x:Name="ChkLaunchNow" Content="اکنون برنامه را اجرا کن" IsChecked="True" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button x:Name="BtnInstall" Content="نصب" Style="{StaticResource Primary}" Click="BtnInstall_Click"/>
            <Button x:Name="BtnFinish" Content="پایان" Style="{StaticResource Primary}" Click="BtnFinish_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
